# Cadena de conexión de Neon (Settings → Connection string, usa la del "pooler").
# En Vercel: Project → Settings → Environment Variables → DATABASE_URL.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.c-5.eu-central-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Clave para firmar la cookie de sesión. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Client ID de OAuth de Google (Google Cloud Console), restringido al
# dominio inmobiliariapalanca.com. Ver README para los pasos de creación.
GOOGLE_CLIENT_ID=
# Mismo valor que arriba, pero con el prefijo VITE_ para que Vite lo
# exponga al frontend (los Client ID de Google no son secretos).
VITE_GOOGLE_CLIENT_ID=
